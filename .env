ENVIRONMENT=development
LOG_LEVEL=info
PORT=8080
APP_NAME=INHERITANCE CHOIR API
APP_VERSION=1.0.0
APP_CURRENCY=RWF
APP_TIMEZONE=Africa/Kigali

# MongoDB
MONGODB_URI=mongodb+srv://laurentniyigena520_db_user:Lani12725@cluster0.r2ae8is.mongodb.net/inheritance_choir?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=umurage
MONGODB_POOL_MIN=2
MONGODB_POOL_MAX=50

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (min 32 chars)
JWT_SECRET=change-this-in-production-at-least-32-chars!
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=720h

# OTP
OTP_EXPIRY=5m
OTP_MAX_ATTEMPTS=3

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://umurag.vercel.app

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=laurentniyigena1@gmail.com
MAIL_PASSWORD=hifnastmglwqakjq
MAIL_FROM=laurentniyigena1@gmail.com
MAIL_FROM_NAME=Inheritance Choir

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m
LOGIN_MAX_ATTEMPTS=5

# Admin defaults
ADMIN_EMAIL=inheritancechoir@gmail.com
ADMIN_PASSWORD=Umurage123.

# Automation
ATTENDANCE_THRESHOLD=70.0
MONTHLY_REMINDER_DAY=5
EVENT_REMINDER_HOURS=24
ENABLE_NOTIFICATIONS=true

# Worker pool
WORKER_POOL_SIZE=20
TASK_QUEUE_SIZE=500
